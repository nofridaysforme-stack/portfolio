# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env.production and fill in the actual values
# NEVER commit .env.production to version control
# Set these variables in Vercel Dashboard: Settings > Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------

# The public URL of your deployed application
# Example: https://yourportfolio.com
NEXT_PUBLIC_SERVER_URL=

# Node environment (should be "production" for production)
NODE_ENV=production

# -----------------------------------------------------------------------------
# PAYLOAD CMS
# -----------------------------------------------------------------------------

# Secret key for Payload CMS (generate a random 32+ character string)
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# MongoDB connection string for production database
# Example: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
DATABASE_URI=

# -----------------------------------------------------------------------------
# FIREBASE CONFIGURATION (Public - Client Side)
# -----------------------------------------------------------------------------
# Get these from Firebase Console > Project Settings > General

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Firebase measurement ID for analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# FIREBASE ADMIN SDK (Private - Server Side Only)
# -----------------------------------------------------------------------------
# Get these from Firebase Console > Project Settings > Service Accounts
# Click "Generate new private key" to download JSON file

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_STORAGE_BUCKET=

# Firebase private key (replace \n with actual newlines in Vercel)
# In Vercel: Paste the actual private key with real line breaks
FIREBASE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# CLOUD STORAGE (Optional - for Payload media uploads)
# -----------------------------------------------------------------------------

# AWS S3 Configuration
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: Custom S3 endpoint (for S3-compatible services like DigitalOcean Spaces)
# S3_ENDPOINT=

# -----------------------------------------------------------------------------
# EMAIL SERVICE (Optional - for contact forms, notifications)
# -----------------------------------------------------------------------------

# Resend API Key (for transactional emails)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=

# Email addresses
EMAIL_FROM=noreply@yourportfolio.com
EMAIL_TO=your-email@example.com

# -----------------------------------------------------------------------------
# ANALYTICS & MONITORING (Optional)
# -----------------------------------------------------------------------------

# Vercel Analytics (automatically enabled on Vercel)
# No configuration needed

# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry (Error tracking)
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_PROJECT=
# SENTRY_ORG=

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------

# Rate limiting configuration
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://yourportfolio.com

# -----------------------------------------------------------------------------
# FEATURE FLAGS (Optional)
# -----------------------------------------------------------------------------

# Enable/disable features
ENABLE_ANALYTICS=true
ENABLE_BLOG=false
ENABLE_CONTACT_FORM=true

# -----------------------------------------------------------------------------
# BUILD CONFIGURATION
# -----------------------------------------------------------------------------

# Disable telemetry
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
#
# 1. Create production MongoDB Atlas cluster
# 2. Create production Firebase project
# 3. Generate Firebase service account key
# 4. Set up AWS S3 bucket (optional)
# 5. Get Resend API key (optional)
# 6. Add all variables to Vercel Dashboard
# 7. Deploy to Vercel preview environment first
# 8. Test all functionality
# 9. Deploy to production
#
# =============================================================================
