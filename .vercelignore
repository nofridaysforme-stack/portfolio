# Vercel Ignore File
# Files and directories to exclude from Vercel deployment
# https://vercel.com/docs/concepts/projects/project-configuration#vercelignore

# Documentation
docs/
*.md
README.md
CHANGELOG.md
LICENSE

# Git files
.git/
.gitignore
.gitattributes

# GitHub
.github/

# Development files
.env.local
.env.development
.env.test
.env*.local

# Testing
__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage/
.nyc_output/
jest.config.js

# Development tools
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# Build analyzer
.next/analyze/

# Backup files
*.backup
backup/

# Seed data (optional - include if you want to seed from deployed functions)
# src/lib/seed/

# Firebase service account (should never be in repo anyway)
*firebase-adminsdk*.json
serviceAccount.json
